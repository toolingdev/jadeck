# Copy beside the ptz binary as ptz.env (or point PTZ_ENV_FILE at it).
# Secrets live here on the machine only, never in the repo.
PTZ_CAMERA_HOST=10.1.10.110
PTZ_CAMERA_USER=admin
PTZ_CAMERA_PASS=
PTZ_PORT=8080
# Signed in-app updates from GitHub Releases
PTZ_UPDATE_REPO=owner/repo
# Only for a private repo: a fine-grained token with read access to Contents
PTZ_UPDATE_TOKEN=
